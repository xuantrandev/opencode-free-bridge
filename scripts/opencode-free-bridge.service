[Unit]
Description=opencode-free-bridge (OpenAI-compatible proxy for opencode free models)
After=network.target

[Service]
Type=simple
# Launcher backgrounds opencode serve + bridge itself, then exits; but we want
# systemd to track the lifetime. `start` returns once both are listening, so we
# use a small watchdog wrapper that keeps the unit alive by tailing the log.
ExecStart=/bin/bash -c '/usr/local/bin/opencode-free-bridge start && tail -F /var/log/opencode-free-bridge.log'
ExecStop=/usr/local/bin/opencode-free-bridge stop
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
