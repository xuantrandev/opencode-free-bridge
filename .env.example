# opencode-free-bridge — copy to .env and edit only what you need.
# .env is gitignored; .env.example is committed. Real environment variables
# always win over values in this file.
#
# The bridge talks to `opencode serve` and auto-discovers the free models of
# the `opencode` provider. Authentication is optional: run the bridge without
# a key on loopback, or set BRIDGE_API_KEY when other processes/users on the
# host can reach the port.

# ============================ Docker (compose) =============================
# Host interface/port the bridge API is published on. Keep 127.0.0.1 unless a
# reverse proxy with authentication sits in front.
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=5577

# Optional gateway API key. When set, clients must send
#     Authorization: Bearer <BRIDGE_API_KEY>
# to /v1/models and /v1/chat/completions. Leave empty to disable.
BRIDGE_API_KEY=
# Docker-secret style alternative: point at a mounted, protected file.
# The file content wins over BRIDGE_API_KEY.
# BRIDGE_API_KEY_FILE=/run/secrets/bridge_api_key

# Shared secret between the bridge and the internal discovery agent that runs
# in the opencode-server container. Change it (the agent only listens on the
# Docker-internal network, but defense in depth).
DISCOVERY_TOKEN=change-me

# Optional basic auth for `opencode serve` itself (internal network only).
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_USERNAME=opencode

# OpenCode CLI version baked into Dockerfile.opencode (pin for reproducibility).
OPENCODE_VERSION=1.19.3
IMAGE_TAG=dev

# Container resource limits. cpus must be <= the host CPU count (raise the
# defaults on bigger hosts, e.g. 2.0/2.0); memory units look like 1g/512m.
OPENCODE_SERVER_MEM_LIMIT=2g
OPENCODE_SERVER_CPUS=1.0
BRIDGE_MEM_LIMIT=1g
BRIDGE_CPUS=1.0

# ============================== Bridge =====================================
# ---- Bridge listener (loopback only when run without Docker) ----
PORT=5577
# HOST=127.0.0.1          # Docker sets 0.0.0.0 internally; compose publishes
                          # to ${BRIDGE_BIND}:${BRIDGE_PORT} instead.
# ---- Upstream: opencode serve (/session API) ----
# Docker Compose overrides this with http://opencode-server:4577.
OPENCODE_UPSTREAM=http://127.0.0.1:4577

# ---- opencode CLI (used for model discovery outside Docker) ----
# Absolute path is auto-filled by scripts/install.sh. Inside Docker the bridge
# discovers models through the internal agent (DISCOVERY_URL) instead of
# executing the CLI, so OPENCODE_BIN is overridden to `opencode`.
OPENCODE_BIN=opencode
OPENCODE_PROVIDER=opencode
OPENCODE_AGENT=general

# ---- Model discovery & sync ----
# Auto-sync discovers new free models, (re)verifies them and hot-deploys the
# registry every MODEL_SYNC_INTERVAL_MINUTES while the bridge is running.
MODEL_AUTO_SYNC=true
MODEL_SYNC_INTERVAL_MINUTES=60
MODEL_SYNC_ON_STARTUP=true
MODEL_AUTO_DEPLOY=true
MODEL_HEALTH_CHECK=true
# Extra exclude patterns (space/comma separated, `*`/`?` wildcards, `re:` prefix
# for regex). config/exclusions.json is the persistent list — prefer that.
MODEL_EXCLUDE=
# Optional: send a 1-token probe to each newly discovered model before deploy
# (costs one real inference per new model; off by default).
MODEL_VALIDATE_INFERENCE=false
MODEL_DISCOVERY_TIMEOUT_MS=60000
MODEL_VERIFY_TIMEOUT_MS=60000
MODEL_VERIFY_CONCURRENCY=1
MODEL_VERIFY_MAX_PER_RUN=3
MODEL_VERIFY_RETRY_HOURS=12

# ---- API security (see also BRIDGE_API_KEY above) ----
# Requests per minute per client IP for /v1/* (0 disables rate limiting).
RATE_LIMIT_RPM=120
# Maximum accepted request body size in bytes (default 10 MiB).
REQUEST_BODY_LIMIT_BYTES=10485760
# Comma-separated list of origins allowed via CORS. Empty = no CORS headers.
CORS_ALLOWED_ORIGINS=

# ---- Upstream request behaviour ----
UPSTREAM_TIMEOUT_MS=300000
UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_RETRIES=2
UPSTREAM_RETRY_BASE_MS=500
HEALTH_UPSTREAM_TIMEOUT_MS=2000
HEALTH_CACHE_MS=10000

# ---- Sessions ----
# per-request: fresh upstream session + DELETE after each request (default).
# shared: one long-lived session reused across requests.
SESSION_MODE=per-request
INCLUDE_HISTORY=true

# ---- Deploy safety ----
DEPLOY_VERIFY_TIMEOUT_MS=10000
DEPLOY_VERIFY_STABLE_MS=20000
SYNC_LOCK_STALE_MS=600000
BACKUP_KEEP=20

# ---- Logging ----
LOG_LEVEL=info
# Empty = logs/bridge.log. LOG_FILE=- logs to the console instead (Docker
# compose uses `-` so `docker compose logs` shows everything).
LOG_FILE=
