# opencode-free-bridge — copy to .env and fill in your secrets.
# .env is gitignored. .env.example is committed.

# ---- Bridge listener ----
# Host is always 127.0.0.1 (loopback only). Change PORT if 5577 is taken.
PORT=5577

# ---- Upstream A: opencode serve (free models, /session API) ----
# Run `opencode serve` (default :4577) somewhere before starting the bridge.
OPENCODE_UPSTREAM=http://127.0.0.1:4577

# ---- Upstream B: opencode-go (paid tier via /v1 API) ----
# Base URL of the opencode-go /v1 endpoint. Trailing slash is stripped.
OPENCODE_GO_BASE=https://opencode.ai/zen/go/v1

# API key for opencode-go. Two ways to provide it:
#   1) OPENCODE_GO_API_KEY=sk-...   (direct)
#   2) leave blank, point OPENCODE_KEY_FILE at a file containing just the key
OPENCODE_GO_API_KEY=
OPENCODE_KEY_FILE=/root/.hermes/scripts/opencode.key
