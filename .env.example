# opencode-free-bridge — copy to .env and edit if you need to.
# .env is gitignored. .env.example is committed.
#
# No API key is required. The bridge only talks to a local `opencode serve`
# upstream and serves the four free models listed in server.mjs.

# ---- Bridge listener ----
# Host is always 127.0.0.1 (loopback only). Change PORT if 5577 is taken.
PORT=5577

# ---- Upstream: opencode serve (free models, /session API) ----
# Run `opencode serve` (default :4577) somewhere before starting the bridge.
OPENCODE_UPSTREAM=http://127.0.0.1:4577
